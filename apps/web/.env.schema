# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
DATABASE_AUTH_TOKEN=

# Better Auth. The secret signs sessions; the URL is the origin the panel is
# served from (http://localhost:3005 in development).
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=http://localhost:3005

# Google OAuth client for sign-in.
# @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# Resend sends the one-time-code email.
# @type=string(minLength=1)
RESEND_API_KEY=

# @type=string(minLength=1)
EMAIL_FROM=humara-neta <sign-in@example.com>
